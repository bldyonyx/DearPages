{
  "rules": {
    "users": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && !newData.exists() && auth.token.auth_time * 1000 > now - 300000",
        "bookNotes": {
          "$bookId": {
            "$noteId": {
              ".write": "auth != null && auth.uid === $uid && $uid.length > 0 && $uid.length <= 128 && !$uid.matches(/[.#$\\[\\]\\/\u0000- \u007f]/) && $bookId.length > 0 && $bookId.length <= 128 && !$bookId.matches(/[.#$\\[\\]\\/\u0000- \u007f]/) && $noteId.length > 0 && $noteId.length <= 128 && !$noteId.matches(/[.#$\\[\\]\\/\u0000- \u007f]/) && root.child('users').child($uid).child('library').child($bookId).exists() && newData.parent().parent().parent().child('library').child($bookId).exists() && (data.exists() || newData.exists()) && (data.exists() || ($noteId !== 'legacy-note-v1' && $noteId !== 'legacy-review-v1'))",
              ".validate": "newData.hasChildren(['title', 'contentHtml', 'date', 'createdAt', 'updatedAt']) && newData.getPriority() === null && (newData.child('updatedAt').val() === now || (data.exists() && newData.child('title').val() === data.child('title').val() && newData.child('contentHtml').val() === data.child('contentHtml').val() && newData.child('date').val() === data.child('date').val() && newData.child('createdAt').val() === data.child('createdAt').val() && newData.child('updatedAt').val() === data.child('updatedAt').val() && newData.child('isPinned').isBoolean()))",
              "title": {
                ".validate": "newData.isString() && newData.val().length <= 200 && !newData.val().matches(/[\u0000-\u001f\u007f<>]/)"
              },
              "contentHtml": {
                ".validate": "newData.isString() && newData.val().length <= 200000 && !newData.val().matches(/[\u0000-\b\u000b\f\u000e-\u001f\u007f]/) && newData.val().matches(/^([^<]|<(b|strong|i|em|div|p)>|<\\/(b|strong|i|em|font|div|p)>|<br>|<font( size=\"[2-5]\")?>)*$/)"
              },
              "date": {
                ".validate": "newData.isString() && !newData.val().beginsWith('0000') && newData.val().matches(/^([0-9]{4}-((01|03|05|07|08|10|12)-(0[1-9]|[12][0-9]|3[01])|(04|06|09|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)$/)"
              },
              "createdAt": {
                ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === now) || (data.exists() && newData.val() === data.val()))"
              },
              "updatedAt": {
                ".validate": "newData.isNumber() && newData.val() >= newData.parent().child('createdAt').val() && (newData.val() === now || (data.exists() && newData.val() === data.val()))"
              },
              "$other": {
                ".validate": false
              },
              "isPinned": {
                ".validate": "newData.isBoolean()"
              }
            },
            ".read": "auth != null && auth.uid === $uid && root.child('users').child($uid).child('library').child($bookId).exists()"
          }
        },
        "profile": {
          ".write": "auth != null && auth.uid === $uid",
          ".read": "auth != null && auth.uid === $uid"
        },
        "preferences": {
          ".write": "auth != null && auth.uid === $uid",
          ".read": "auth != null && auth.uid === $uid"
        },
        "library": {
          ".write": "auth != null && auth.uid === $uid",
          ".read": "auth != null && auth.uid === $uid"
        },
        "collections": {
          ".write": "auth != null && auth.uid === $uid",
          ".read": "auth != null && auth.uid === $uid"
        },
        "bookRatings": {
          "$bookId": {
            "$ratingId": {
              ".write": "auth != null && auth.uid === $uid && $uid.length > 0 && $uid.length <= 128 && !$uid.matches(/[.#$\\[\\]\\/\u0000- \u007f]/) && $bookId.length > 0 && $bookId.length <= 128 && !$bookId.matches(/[.#$\\[\\]\\/\u0000- \u007f]/) && root.child('users').child($uid).child('library').child($bookId).exists() && newData.parent().parent().parent().child('library').child($bookId).exists() && newData.exists() && data.child('deleted').val() !== true && ((newData.child('deleted').val() === true && data.exists()) || (root.child('users').child($uid).child('library').child($bookId).child('status').val() === 'finished' && newData.parent().parent().parent().child('library').child($bookId).child('status').val() === 'finished')) && ($ratingId.matches(/^-[A-Za-z0-9_-]{19}$/) || ($ratingId === 'legacy-rating-v1' && data.exists()))",
              ".validate": "newData.getPriority() === null && ((newData.hasChildren(['value', 'date', 'revision', 'createdAt', 'updatedAt']) && !newData.child('deleted').exists()) || (newData.hasChildren(['deleted', 'revision', 'createdAt', 'updatedAt']) && data.exists() && newData.child('deleted').val() === true && !newData.child('value').exists() && !newData.child('date').exists() && !newData.child('impression').exists()))",
              "value": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 5 && newData.val() % 1 === 0"
              },
              "date": {
                ".validate": "newData.isString() && ((newData.val() === '' && $ratingId === 'legacy-rating-v1' && (!data.exists() || data.val() === '')) || (!newData.val().beginsWith('0000') && newData.val().matches(/^([0-9]{4}-((01|03|05|07|08|10|12)-(0[1-9]|[12][0-9]|3[01])|(04|06|09|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))|([0-9]{2}(0[48]|[2468][048]|[13579][26])|(0[48]|[2468][048]|[13579][26])00)-02-29)$/)))"
              },
              "revision": {
                ".validate": "newData.isNumber() && newData.val() % 1 === 0 && ((!data.exists() && newData.val() === 1) || (data.exists() && newData.val() === data.val() + 1))"
              },
              "createdAt": {
                ".validate": "newData.isNumber() && ((!data.exists() && newData.val() === now) || (data.exists() && newData.val() === data.val()))"
              },
              "updatedAt": {
                ".validate": "newData.isNumber() && newData.val() === now && newData.val() >= newData.parent().child('createdAt').val()"
              },
              "deleted": {
                ".validate": "data.parent().exists() && newData.val() === true"
              },
              "$other": {
                ".validate": false
              },
              "impression": {
                ".validate": "newData.isString() && newData.val().length <= 160 && !newData.val().matches(/[\u0000-\u001f\u007f]/) && ($ratingId !== 'legacy-rating-v1' || data.parent().exists())"
              }
            },
            ".read": "auth != null && auth.uid === $uid && root.child('users').child($uid).child('library').child($bookId).exists()"
          }
        },
        "bookNotesLegacy": {
          "$bookId": {
            ".read": "auth != null && auth.uid === $uid && root.child('users').child($uid).child('library').child($bookId).exists()"
          }
        },
        "bookReviewsLegacy": {
          "$bookId": {
            ".read": "auth != null && auth.uid === $uid && root.child('users').child($uid).child('library').child($bookId).exists()"
          }
        },
        "bookRatingsLegacy": {
          "$bookId": {
            ".read": "auth != null && auth.uid === $uid && root.child('users').child($uid).child('library').child($bookId).exists()"
          }
        }
      }
    }
  }
}
